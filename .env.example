# Database Configuration
#
# Calendry uses TWO database roles by design. Tenant isolation is enforced by
# PostgreSQL row-level security, and an owning role bypasses RLS unless FORCE
# is set (and can always remove FORCE). Keeping the runtime connection on a
# non-owner role is what makes isolation a database guarantee rather than an
# application convention.
#
#   POSTGRES_USER  — owner. Owns the schema, runs migrations. NOT used at runtime.
#   APP_DB_USER    — runtime. DML only, no ownership, subject to FORCE RLS.

# PostgreSQL superuser / schema owner.
# IMPORTANT: Use strong, unique passwords in production.
POSTGRES_USER=calendry
POSTGRES_PASSWORD=changeme-owner-password
POSTGRES_DB=calendrydb

# Runtime role. Provisioned at cluster init by .config/db-init/01-app-role.sh.
APP_DB_USER=calendry_app
APP_DB_PASSWORD=changeme-app-password

# Runtime connection used by the Nuxt server — the app role, RLS applies.
# Every request must open a transaction and set its tenant context:
#   SET LOCAL calendry.tenant_id = '<tenant id>';
#   SET LOCAL calendry.federation_id = '<federation id or empty>';
# With no context set, every policy evaluates to NULL and the connection sees
# zero rows. That is intentional — a forgotten SET LOCAL must leak nothing.
DATABASE_URL=postgresql://calendry_app:changeme-app-password@db:5432/calendrydb

# The runtime role addressed from OUTSIDE the compose network, for host-run
# tooling that needs no owner privileges (e.g. `bun run reset:password`).
DATABASE_URL_HOST=postgresql://calendry_app:changeme-app-password@localhost:55432/calendrydb

# Migration connection used by the Prisma CLI only — the owner role.
# `db` is a compose-internal hostname, so this form works only INSIDE a container.
MIGRATION_DATABASE_URL=postgresql://calendry:changeme-owner-password@db:5432/calendrydb

# The same database, addressed from OUTSIDE the compose network. Anything run
# from your own shell needs this: the Prisma CLI, the integration tests, and
# `bun run provision:tenant` (which prefers it over the variable above).
# Relies on the port docker-compose.dev.yml publishes.
MIGRATION_DATABASE_URL_HOST=postgresql://calendry:changeme-owner-password@localhost:55432/calendrydb

# CORS Configuration (optional)
# Comma-separated list of allowed origins for Socket.io connections
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
# Leave empty or use '*' to allow all origins (not recommended for production)
ALLOWED_ORIGINS=
